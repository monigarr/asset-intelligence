# Copy to .env and fill — NEVER commit .env

#https://dev.meta.ai/api-keys
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
# Image generation exceeds the 15s default timeout — raise for synthetic gen.
# META_API_TIMEOUT_S=180

# Asset Intelligence API auth (X-API-Key header). Unset = documented dev key,
# local demos only — set this for anything shared (see SECURITY.md §2).
# API_KEY=

# Live-verified 2026-10-27 against GET /v1/models (9 models, none Llama):
# image + planning IDs below are verified; VISION IDs have no verified
# replacement yet (see SECURITY.md §11 before running live eval).
VISION_MODEL_ID=muse-spark-1.3
FALLBACK_VISION_MODEL_ID=muse-spark-1.3

SAM_MODEL_ID=sam-3.1
REASONING_MODEL_ID=muse-spark-1.3
PLANNING_MODEL_ID=muse-wonder-1.0
IMAGE_MODEL_ID=muse-image-1.0
BASETEN_MODEL_ID=meta-models/muse-spark-open-1026
MODAL_MODEL_ID=
FIREWORK_MODEL_ID=

# BASETEN.CO
BASETEN_API_BASE=

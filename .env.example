# Copy to .env and fill — NEVER commit .env

#https://dev.meta.ai/api-keys
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
# Image generation exceeds the 15s default timeout — raise for synthetic gen.
# META_API_TIMEOUT_S=180

# Asset Intelligence API auth (X-API-Key header). Unset = documented dev key,
# local demos only — set this for anything shared (see SECURITY.md §2).
# API_KEY=

# Live-verified 2026-10-27 against GET /v1/models (9 models, none Llama):
# image + planning IDs below are verified; VISION IDs have no verified
# replacement yet (see SECURITY.md §11 before running live eval).
VISION_MODEL_ID=muse-spark-1.3
FALLBACK_VISION_MODEL_ID=muse-spark-1.3

SAM_MODEL_ID=sam-3.1
REASONING_MODEL_ID=muse-spark-1.3
PLANNING_MODEL_ID=muse-wonder-1.0
IMAGE_MODEL_ID=muse-image-1.0
# Open-weights partners (Baseten/Modal/Fireworks) removed in v1.1: no live
# Llama model on the Meta Model API; re-add when a verified endpoint exists.

# --- Cost metering (app/gateway/pricing.py) ---
# Source: Meta developer console pricing page, observed 2026-10-28 (Standard
# API mode). Re-confirm against your Meta console invoice before quoting costs.
# Units: PLAIN NUMBERS only -- no "$", no "/1000 images" suffixes (anything
# else raises ValueError). Token rates are USD CENTS per 1k tokens:
# cents/1k = $/1M / 10.
#   muse-spark-1.3:  $1.25/M in, $0.15/M cached in, $4.25/M out
#   muse-wonder-1.0: $4/M in, $0.20/M cached in, $20/M out
#   sam-3.1: $2.50/1000 images ($0.0025/image); video $0.20/1000 frames
#     (reserved: this app has no video path yet)
#   muse-image-1.0: $0.01/hour (metered per image -- set the override below
#     from YOUR measured images/hour)
#   muse-voice transcribe $0.18/hour: reserved (model not used by this app)
#   Contributor-tier Spark (1.2/1.3): $0.10/M in, $0.002/M cached in,
#   $0.20/M out -- if you run contributor tier, put THOSE numbers in the
#   _INPUT/_OUTPUT vars instead of the Standard ones.
# Split rates win when BOTH _INPUT and _OUTPUT are set; the bare per-model
# var is the legacy blended fallback (kept for custom in/out mixes).
# META_PRICE_PER_1K_CENTS_MUSE_SPARK_1_3_INPUT=0.125
# META_PRICE_PER_1K_CENTS_MUSE_SPARK_1_3_CACHED_INPUT=0.015
# META_PRICE_PER_1K_CENTS_MUSE_SPARK_1_3_OUTPUT=0.425
# META_PRICE_PER_1K_CENTS_MUSE_WONDER_1_0_INPUT=0.4
# META_PRICE_PER_1K_CENTS_MUSE_WONDER_1_0_CACHED_INPUT=0.02
# META_PRICE_PER_1K_CENTS_MUSE_WONDER_1_0_OUTPUT=2.0
# META_PRICE_PER_1K_CENTS_MUSE_SPARK_1_3=
# META_PRICE_PER_1K_CENTS_MUSE_WONDER_1_0=
# META_PRICE_PER_IMAGE_CENTS_SAM_3_1=0.25
# META_PRICE_PER_IMAGE_CENTS_MUSE_IMAGE_1_0=
# Pricing tier: when set, token lookups prefer tier-suffixed schedules
# (META_PRICE_PER_1K_CENTS_<MODEL>_<TIER>_{INPUT,OUTPUT,...}), falling back
# to the base vars above when the tier schedule is incomplete. Set ONLY if
# your usage is billed at that tier; unset means Standard.
# META_PRICE_TIER=contributor
# META_PRICE_PER_1K_CENTS_MUSE_SPARK_1_3_CONTRIBUTOR_INPUT=0.01
# META_PRICE_PER_1K_CENTS_MUSE_SPARK_1_3_CONTRIBUTOR_CACHED_INPUT=0.0002
# META_PRICE_PER_1K_CENTS_MUSE_SPARK_1_3_CONTRIBUTOR_OUTPUT=0.02
# Hourly rates (USD cents/hour, plain numbers) for time-metered models.
# META_PRICE_PER_1_HOUR_MUSE_IMAGE_1_0_OUTPUT=1.0
# muse-voice-transcribe at $0.18/h = 18.0 is reserved (no voice path yet).

# --- JWT auth for the review UI (FR-09; Bearer alternative to API key) ---
# JWT_SECRET=            # required to enable /v1/auth/* (long random string)
# UI_USERNAME=reviewer
# UI_PASSWORD_HASH=      # argon2 hash; mint with:
#   python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('pw'))"

# --- Rate-limit storage (slowapi; Valkey speaks RESP, redis-py client) ---
# Local default is memory:// (single worker). Compose sets redis://valkey:6379.
# RATE_LIMIT_STORAGE_URI=memory://

# Data - real vs synthetic -- keep synthetic, ignore real
samples/raw/
samples/private/
samples/customer/
data/
datasets/
*.jpg
*.jpeg
*.png
*.webp
*.mp4
*.mov
# Allow synthetic demo images
!samples/demo/
!samples/demo/**
!samples/synthetic/
# eval/cases/synthetic: golden set commits (JSONs + manifest + images/*.png)
# so new developers can onboard and run evals without regenerating. 50 PNGs,
# ~205MB total, each under GitHub's 100MB/file limit (max ~5.2MB).
!eval/cases/synthetic/
!eval/cases/synthetic/images/*.png
!eval/cases/demo/

# marketing/: local-only brand/campaign assets. Previously committed
# logo files remain tracked; everything new under marketing/ is ignored.
marketing/

# Review-UI demo fixtures: committed images + JSON, shipped in the UI build.
!app/ui/public/fixtures/
!app/ui/public/fixtures/**

